{
  "name": "tauri-notes",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "scripts": {
    "dev": "vite --port 1420",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "tsc --noEmit && vitest run",
    "e2e": "playwright test",
    "verify": "npm run check && npm run build",
    "version:check": "cargo run --quiet --manifest-path scripts/Cargo.toml -p release -- version check",
    "version:set": "cargo run --quiet --manifest-path scripts/Cargo.toml -p release -- version set",
    "verify:all": "cargo run --quiet --manifest-path scripts/Cargo.toml -p verify --",
    "mobile:doctor": "cargo run --quiet --manifest-path scripts/Cargo.toml -p mobile -- doctor",
    "mobile:devices": "cargo run --quiet --manifest-path scripts/Cargo.toml -p mobile -- devices",
    "mobile:start": "cargo run --quiet --manifest-path scripts/Cargo.toml -p mobile -- start",
    "mobile:up": "cargo run --quiet --manifest-path scripts/Cargo.toml -p mobile -- up",
    "mobile:launch": "cargo run --quiet --manifest-path scripts/Cargo.toml -p mobile -- launch",
    "mobile:install": "cargo run --quiet --manifest-path scripts/Cargo.toml -p mobile -- install",
    "mobile:screenshot": "cargo run --quiet --manifest-path scripts/Cargo.toml -p mobile -- screenshot",
    "mobile:smoke": "cargo run --quiet --manifest-path scripts/Cargo.toml -p mobile -- smoke",
    "mobile:reset": "cargo run --quiet --manifest-path scripts/Cargo.toml -p mobile -- reset",
    "mobile:stop": "cargo run --quiet --manifest-path scripts/Cargo.toml -p mobile -- stop",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@xyflow/react": "^12.12.0",
    "dockview": "^8.6.1",
    "dockview-react": "^8.6.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^3.0.0"
  }
}
